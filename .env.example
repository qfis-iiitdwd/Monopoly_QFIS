# Copy to .env and fill in. Never commit .env.
# Used by the single-server deployment (docker-compose.prod.yml + Caddy). For local development
# the defaults need no .env at all.
COMPOSE_FILE=docker-compose.prod.yml

# The public address, e.g. market.qfis.in. Its DNS A record must point at this server.
DOMAIN=market.example.com

# Long random strings, e.g. from: openssl rand -base64 24
POSTGRES_PASSWORD=
ADMIN_PASSWORD=

# Raise to 40 only if the database is on another machine with >10 ms latency.
DB_POOL_SIZE=20
