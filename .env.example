# Copy to .env and fill in. Never commit .env.
# Used by the single-server deployment (docker-compose.prod.yml + Caddy), and by `npm start`, the
# seed, preflight, backup and restore scripts on a laptop. The database is Supabase only.
COMPOSE_FILE=docker-compose.prod.yml

# The public address, e.g. market.qfis.in. Its DNS A record must point at this server.
DOMAIN=market.example.com

# Supabase: Connect → Session pooler (port 5432) URI, with the database password filled in.
# Percent-encode special characters in the password (e.g. @ → %40). See docs/SUPABASE.md.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Long random string, e.g. from: openssl rand -base64 24
ADMIN_PASSWORD=

# Set to 40 for high concurrency or if the database is >10 ms away. Supabase's Pool Size must be at least this + 14 (≥ 54).
DB_POOL_SIZE=40

# For `npm test`: a SEPARATE Supabase project. The tests wipe it; they refuse to use DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres.<test-project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional: DB_SSL=verify checks Supabase's certificate (save it as config/supabase-ca.crt or set DB_SSL_CA).
# DB_SSL=verify
